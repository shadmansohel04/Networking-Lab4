#!/bin/bash

# --- 1. INTERFACE CONFIGURATION (R13 Eglinton) ---
# Connection to R14 (Clarkson): Subnet 10.4.1.0/24
/sbin/ifconfig eth1 10.4.1.1 netmask 255.255.255.0 up

# Connection to R16 (Appleby): Subnet 10.4.2.0/24
/sbin/ifconfig eth2 10.4.2.2 netmask 255.255.255.0 up

# Disable unused interface
/sbin/ifconfig eth0 down

# --- 2. ENABLE IP FORWARDING ---
echo 1 > /proc/sys/net/ipv4/ip_forward

# --- 3. CLEAN EXISTING ROUTES ---
/sbin/route del default 2>/dev/null

# --- 4. STATIC ROUTING TABLE ---

# Via Gateway 10.4.2.1 (R16 Appleby)
# 10.4.3.0 Subnet (Between R16 and R15)
/sbin/route add -net 10.4.3.0 netmask 255.255.255.0 gw 10.4.2.1 dev eth2

# Via Gateway 10.4.1.2 (R14 Clarkson)
# All other subnets reachable through R14
/sbin/route add -net 10.1.1.0 netmask 255.255.255.0 gw 10.4.1.2 dev eth1
/sbin/route add -net 10.1.2.0 netmask 255.255.255.0 gw 10.4.1.2 dev eth1
/sbin/route add -net 10.1.3.0 netmask 255.255.255.0 gw 10.4.1.2 dev eth1
/sbin/route add -net 10.1.4.0 netmask 255.255.255.0 gw 10.4.1.2 dev eth1
/sbin/route add -net 10.1.5.0 netmask 255.255.255.0 gw 10.4.1.2 dev eth1
/sbin/route add -net 10.1.6.0 netmask 255.255.255.0 gw 10.4.1.2 dev eth1
/sbin/route add -net 10.1.7.0 netmask 255.255.255.0 gw 10.4.1.2 dev eth1

/sbin/route add -net 10.2.1.0 netmask 255.255.255.0 gw 10.4.1.2 dev eth1
/sbin/route add -net 10.2.2.0 netmask 255.255.255.0 gw 10.4.1.2 dev eth1
/sbin/route add -net 10.2.3.0 netmask 255.255.255.0 gw 10.4.1.2 dev eth1
/sbin/route add -net 10.2.4.0 netmask 255.255.255.0 gw 10.4.1.2 dev eth1

/sbin/route add -net 10.3.1.0 netmask 255.255.255.0 gw 10.4.1.2 dev eth1
/sbin/route add -net 10.3.2.0 netmask 255.255.255.0 gw 10.4.1.2 dev eth1
/sbin/route add -net 10.3.3.0 netmask 255.255.255.0 gw 10.4.1.2 dev eth1
/sbin/route add -net 10.3.4.0 netmask 255.255.255.0 gw 10.4.1.2 dev eth1

/sbin/route add -net 10.4.4.0 netmask 255.255.255.0 gw 10.4.1.2 dev eth1

/sbin/route add -net 10.5.1.0 netmask 255.255.255.0 gw 10.4.1.2 dev eth1
/sbin/route add -net 10.5.2.0 netmask 255.255.255.0 gw 10.4.1.2 dev eth1
/sbin/route add -net 10.5.3.0 netmask 255.255.255.0 gw 10.4.1.2 dev eth1
/sbin/route add -net 10.5.4.0 netmask 255.255.255.0 gw 10.4.1.2 dev eth1

/sbin/route add -net 192.168.98.0 netmask 255.255.255.0 gw 10.4.1.2 dev eth1
