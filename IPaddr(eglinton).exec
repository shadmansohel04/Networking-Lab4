//IFCONFIG
(R14 CLARKSON)
/sbin/ifconfig eth1 10.4.1.1 netmask 255.255.255.0 up
(R16 APPLEBY)
/sbin/ifconfig eth2 10.4.2.2 netmask 255.255.255.0 up

//IPFORWARDING
echo 1 > /proc/sys/net/ipv4/ip_forward

//IFCONFIG ETH0 UNUSED
/sbin/ifconfig eth0 down

//ETHERNET
ETH0 DROPPED
ETH1 (35) -> 38 (ETH1 R14)
ETH2 (36) -> 43 (ETH0 R16)

//START ROUTING TABLE
(R15)
/sbin/route add -host 10.4.4.2 gw 10.4.1.2 dev eth1
