// R14's 1 hop away
(R15)
/sbin/ifconfig eth0 10.4.4.1 netmask 255.255.255.0 up
(R13)
/sbin/ifconfig eth1 10.4.1.2 netmask 255.255.255.0 up
(R4)
/sbin/ifconfig eth2 10.1.5.2 netmask 255.255.255.0 up

//IPFORWARDING
echo 1 > /proc/sys/net/ipv4/ip_forward

//START ROUTING TABLE
ETH0 (37) -> 40 (ETH0 R15)
ETH1 (38) -> 35 (ETH1 R13)
ETH2 (39) -> (R4)

# ---- via R4 (10.1.5.1, eth2) ----
# 10.1.x
/sbin/route add -net 10.1.1.0 netmask 255.255.255.0 gw 10.1.5.1 dev eth2    # R1-R2
/sbin/route add -net 10.1.2.0 netmask 255.255.255.0 gw 10.1.5.1 dev eth2    # R1-R3
/sbin/route add -net 10.1.3.0 netmask 255.255.255.0 gw 10.1.5.1 dev eth2    # R3-R4
/sbin/route add -net 10.1.4.0 netmask 255.255.255.0 gw 10.1.5.1 dev eth2    # R2-R4-R12
/sbin/route add -net 10.1.6.0 netmask 255.255.255.0 gw 10.1.5.1 dev eth2    # R2-R7
/sbin/route add -net 10.1.7.0 netmask 255.255.255.0 gw 10.1.5.1 dev eth2    # R3-R18
# 10.2.x
/sbin/route add -net 10.2.1.0 netmask 255.255.255.0 gw 10.1.5.1 dev eth2    # R8-R5
/sbin/route add -net 10.2.2.0 netmask 255.255.255.0 gw 10.1.5.1 dev eth2    # R7-R8
/sbin/route add -net 10.2.3.0 netmask 255.255.255.0 gw 10.1.5.1 dev eth2    # R7-R6
/sbin/route add -net 10.2.4.0 netmask 255.255.255.0 gw 10.1.5.1 dev eth2    # R5-R6
# 10.3.x
/sbin/route add -net 10.3.1.0 netmask 255.255.255.0 gw 10.1.5.1 dev eth2    # R9-R10
/sbin/route add -net 10.3.2.0 netmask 255.255.255.0 gw 10.1.5.1 dev eth2    # R9-R12
/sbin/route add -net 10.3.3.0 netmask 255.255.255.0 gw 10.1.5.1 dev eth2    # R12-R11
/sbin/route add -net 10.3.4.0 netmask 255.255.255.0 gw 10.1.5.1 dev eth2    # R10-R11
# 10.5.x
/sbin/route add -net 10.5.1.0 netmask 255.255.255.0 gw 10.1.5.1 dev eth2    # R17-R18
