// R14's 1 hop away
(R15)
/sbin/ifconfig eth0 10.4.4.1 netmask 255.255.255.0 up
(R13)
/sbin/ifconfig eth1 10.4.1.2 netmask 255.255.255.0 up
(R4)
/sbin/ifconfig eth2 10.1.5.2 netmask 255.255.255.0 up

//IPFORWARDING
echo 1 > /proc/sys/net/ipv4/ip_forward

//START ROUTING TABLE
ETH0 (37) -> 40 (ETH0 R15)
ETH1 (38) -> 35 (ETH1 R13)
ETH2 (39) -> (R4)

//OTHER ROUTERS NOT DIRECTLY CONNECTED
(R16)
/sbin/route add -host 10.4.2.1 gw 10.4.1.1 dev eth1
