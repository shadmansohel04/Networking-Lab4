#!/bin/bash

# --- Interfaces ---
# R14 to R15
/sbin/ifconfig eth0 10.4.4.1 netmask 255.255.255.0 broadcast 10.4.4.255 up
# R14 to R13
/sbin/ifconfig eth1 10.4.1.2 netmask 255.255.255.0 broadcast 10.4.1.255 up
# R14 to R4
/sbin/ifconfig eth2 10.1.5.2 netmask 255.255.255.0 broadcast 10.1.5.255 up

# --- Kernel IP Settings ---
# Enable IP Forwarding
echo 1 > /proc/sys/net/ipv4/ip_forward
# Allow responding to broadcast pings (for Lab 4 Step 9)
echo 0 > /proc/sys/net/ipv4/icmp_echo_ignore_broadcasts

# --- Routing Table ---

# ---- via R4 (10.1.5.1, eth2) ----
# 10.1.x
/sbin/route add -net 10.1.1.0 netmask 255.255.255.0 gw 10.1.5.1 dev eth2
/sbin/route add -net 10.1.2.0 netmask 255.255.255.0 gw 10.1.5.1 dev eth2
/sbin/route add -net 10.1.3.0 netmask 255.255.255.0 gw 10.1.5.1 dev eth2
/sbin/route add -net 10.1.4.0 netmask 255.255.255.0 gw 10.1.5.1 dev eth2
/sbin/route add -net 10.1.6.0 netmask 255.255.255.0 gw 10.1.5.1 dev eth2
/sbin/route add -net 10.1.7.0 netmask 255.255.255.0 gw 10.1.5.1 dev eth2
# 10.2.x
/sbin/route add -net 10.2.1.0 netmask 255.255.255.0 gw 10.1.5.1 dev eth2
/sbin/route add -net 10.2.2.0 netmask 255.255.255.0 gw 10.1.5.1 dev eth2
/sbin/route add -net 10.2.3.0 netmask 255.255.255.0 gw 10.1.5.1 dev eth2
/sbin/route add -net 10.2.4.0 netmask 255.255.255.0 gw 10.1.5.1 dev eth2
# 10.3.x
/sbin/route add -net 10.3.1.0 netmask 255.255.255.0 gw 10.1.5.1 dev eth2
/sbin/route add -net 10.3.2.0 netmask 255.255.255.0 gw 10.1.5.1 dev eth2
/sbin/route add -net 10.3.3.0 netmask 255.255.255.0 gw 10.1.5.1 dev eth2
/sbin/route add -net 10.3.4.0 netmask 255.255.255.0 gw 10.1.5.1 dev eth2
# 10.5.x
/sbin/route add -net 10.5.1.0 netmask 255.255.255.0 gw 10.1.5.1 dev eth2
/sbin/route add -net 10.5.2.0 netmask 255.255.255.0 gw 10.1.5.1 dev eth2
/sbin/route add -net 10.5.3.0 netmask 255.255.255.0 gw 10.1.5.1 dev eth2
/sbin/route add -net 10.5.4.0 netmask 255.255.255.0 gw 10.1.5.1 dev eth2
# Internet
/sbin/route add -net 192.168.98.0 netmask 255.255.255.0 gw 10.1.5.1 dev eth2

# ---- via R13 (10.4.1.1, eth1) ----
# R16 connection
/sbin/route add -net 10.4.2.0 netmask 255.255.255.0 gw 10.4.1.1 dev eth1

# ---- via R15 (10.4.4.2, eth0) ----
# R16 connection
/sbin/route add -net 10.4.3.0 netmask 255.255.255.0 gw 10.4.4.2 dev eth0
